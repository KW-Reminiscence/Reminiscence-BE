{
  "components": {
    "schemas": {
      "AnomalyMode": {
        "description": "Primary evaluation mode used for a domain.",
        "enum": [
          "COLD_START",
          "ISOLATION_FOREST",
          "INSUFFICIENT_DATA"
        ],
        "title": "AnomalyMode",
        "type": "string"
      },
      "AnomalyStatus": {
        "description": "Current individual state.",
        "enum": [
          "NORMAL",
          "ANOMALOUS"
        ],
        "title": "AnomalyStatus",
        "type": "string"
      },
      "AuthRole": {
        "description": "Supported single-appliance browser roles.",
        "enum": [
          "GUARDIAN",
          "TABLET"
        ],
        "title": "AuthRole",
        "type": "string"
      },
      "CompleteConversationRequest": {
        "description": "Tablet-observed reason for finalizing a conversation.",
        "properties": {
          "reason": {
            "$ref": "#/components/schemas/ConversationCompletionReason",
            "default": "USER_FINISHED"
          }
        },
        "title": "CompleteConversationRequest",
        "type": "object"
      },
      "ConversationCompletionReason": {
        "description": "Why the tablet finalized an active conversation.",
        "enum": [
          "USER_FINISHED",
          "INACTIVITY_TIMEOUT",
          "MAX_DURATION",
          "NAVIGATION"
        ],
        "title": "ConversationCompletionReason",
        "type": "string"
      },
      "ConversationSource": {
        "description": "How the user entered a conversation session.",
        "enum": [
          "SCHEDULED",
          "VOLUNTARY"
        ],
        "title": "ConversationSource",
        "type": "string"
      },
      "ConversationStatus": {
        "description": "Lifecycle state for a conversation session.",
        "enum": [
          "ACTIVE",
          "COMPLETED"
        ],
        "title": "ConversationStatus",
        "type": "string"
      },
      "ConversationSuggestionResponse": {
        "description": "Daily suggestion state consumed by the tablet home screen.",
        "properties": {
          "display_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Text"
          },
          "scheduled_time": {
            "format": "time",
            "title": "Scheduled Time",
            "type": "string"
          },
          "spoken_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spoken Text"
          },
          "start_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Label"
          },
          "suggested": {
            "title": "Suggested",
            "type": "boolean"
          }
        },
        "required": [
          "suggested",
          "scheduled_time",
          "display_text",
          "spoken_text",
          "start_label"
        ],
        "title": "ConversationSuggestionResponse",
        "type": "object"
      },
      "ConversationSummaryResponse": {
        "description": "Persisted session aggregate without conversation text.",
        "properties": {
          "average_turn_duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Turn Duration Seconds"
          },
          "average_utterance_chars": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Utterance Chars"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "completion_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConversationCompletionReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "no_response_count": {
            "title": "No Response Count",
            "type": "integer"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConversationStatus"
          },
          "total_utterance_chars": {
            "title": "Total Utterance Chars",
            "type": "integer"
          },
          "user_turn_count": {
            "title": "User Turn Count",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "status",
          "started_at",
          "completed_at",
          "completion_reason",
          "user_turn_count",
          "total_utterance_chars",
          "average_utterance_chars",
          "average_turn_duration_seconds",
          "no_response_count"
        ],
        "title": "ConversationSummaryResponse",
        "type": "object"
      },
      "CurrentRoutinesResponse": {
        "description": "Active routine prompts at the server's current time.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RoutinePromptResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          }
        },
        "required": [
          "server_time",
          "items"
        ],
        "title": "CurrentRoutinesResponse",
        "type": "object"
      },
      "DomainEvaluationResponse": {
        "description": "One detector's explainable current state.",
        "properties": {
          "feature_names": {
            "items": {
              "type": "string"
            },
            "title": "Feature Names",
            "type": "array"
          },
          "isolation_forest_signal": {
            "title": "Isolation Forest Signal",
            "type": "boolean"
          },
          "mode": {
            "$ref": "#/components/schemas/AnomalyMode"
          },
          "observation_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Key"
          },
          "persistence_signal": {
            "title": "Persistence Signal",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "rule_based_signal": {
            "title": "Rule Based Signal",
            "type": "boolean"
          },
          "sample_count": {
            "title": "Sample Count",
            "type": "integer"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "signal_count": {
            "title": "Signal Count",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/AnomalyStatus"
          }
        },
        "required": [
          "status",
          "mode",
          "sample_count",
          "score",
          "reasons",
          "feature_names",
          "rule_based_signal",
          "isolation_forest_signal",
          "persistence_signal",
          "signal_count",
          "observation_key"
        ],
        "title": "DomainEvaluationResponse",
        "type": "object"
      },
      "GuardianLoginRequest": {
        "description": "Plaintext password accepted only over the production HTTPS origin.",
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "GuardianLoginRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "A successful process liveness response.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "PersonalStateResponse": {
        "description": "Combined current state with separate domain details.",
        "properties": {
          "became_anomalous": {
            "title": "Became Anomalous",
            "type": "boolean"
          },
          "consecutive_anomalous_evaluations": {
            "title": "Consecutive Anomalous Evaluations",
            "type": "integer"
          },
          "conversation": {
            "$ref": "#/components/schemas/DomainEvaluationResponse"
          },
          "evaluated_at": {
            "format": "date-time",
            "title": "Evaluated At",
            "type": "string"
          },
          "routine": {
            "$ref": "#/components/schemas/DomainEvaluationResponse"
          },
          "status": {
            "$ref": "#/components/schemas/AnomalyStatus"
          }
        },
        "required": [
          "evaluated_at",
          "status",
          "became_anomalous",
          "consecutive_anomalous_evaluations",
          "routine",
          "conversation"
        ],
        "title": "PersonalStateResponse",
        "type": "object"
      },
      "PhotoMemoryResponse": {
        "description": "Photo and family-provided context rendered by the tablet.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "event": {
            "title": "Event",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "image_base64": {
            "title": "Image Base64",
            "type": "string"
          },
          "image_media_type": {
            "title": "Image Media Type",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "people": {
            "items": {
              "type": "string"
            },
            "title": "People",
            "type": "array"
          }
        },
        "required": [
          "id",
          "image_base64",
          "image_media_type",
          "location",
          "people",
          "event",
          "description"
        ],
        "title": "PhotoMemoryResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Successful checks for every local runtime dependency.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RoutineCategory": {
        "description": "Supported routine categories in the MVP.",
        "enum": [
          "MEAL",
          "MEDICATION"
        ],
        "title": "RoutineCategory",
        "type": "string"
      },
      "RoutineExecutionResponse": {
        "description": "Persisted result for one routine occurrence.",
        "properties": {
          "closed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "confirmation_delay_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmation Delay Seconds"
          },
          "confirmed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed At"
          },
          "execution_id": {
            "title": "Execution Id",
            "type": "string"
          },
          "reminder_count": {
            "title": "Reminder Count",
            "type": "integer"
          },
          "routine_id": {
            "title": "Routine Id",
            "type": "string"
          },
          "scheduled_at": {
            "format": "date-time",
            "title": "Scheduled At",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RoutineState"
          }
        },
        "required": [
          "execution_id",
          "routine_id",
          "state",
          "scheduled_at",
          "reminder_count",
          "confirmed_at",
          "confirmation_delay_seconds",
          "closed_at"
        ],
        "title": "RoutineExecutionResponse",
        "type": "object"
      },
      "RoutinePromptResponse": {
        "description": "One active routine prompt rendered and spoken by the tablet.",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/RoutineCategory"
          },
          "confirm_label": {
            "title": "Confirm Label",
            "type": "string"
          },
          "display_text": {
            "title": "Display Text",
            "type": "string"
          },
          "execution_id": {
            "title": "Execution Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reminder_count": {
            "title": "Reminder Count",
            "type": "integer"
          },
          "routine_id": {
            "title": "Routine Id",
            "type": "string"
          },
          "scheduled_at": {
            "format": "date-time",
            "title": "Scheduled At",
            "type": "string"
          },
          "spoken_text": {
            "title": "Spoken Text",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RoutineState"
          }
        },
        "required": [
          "execution_id",
          "routine_id",
          "name",
          "category",
          "state",
          "scheduled_at",
          "reminder_count",
          "display_text",
          "spoken_text",
          "confirm_label"
        ],
        "title": "RoutinePromptResponse",
        "type": "object"
      },
      "RoutineState": {
        "description": "Lifecycle states for one scheduled routine occurrence.",
        "enum": [
          "REMINDING",
          "CONFIRMED",
          "NOT_ANSWERED"
        ],
        "title": "RoutineState",
        "type": "string"
      },
      "SessionResponse": {
        "description": "Non-sensitive current session metadata.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AuthRole"
          }
        },
        "required": [
          "role",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SpeechSynthesisRequest": {
        "description": "Visible spoken_text to synthesize with the configured local voice.",
        "properties": {
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "SpeechSynthesisRequest",
        "type": "object"
      },
      "SpeechTextResponse": {
        "description": "Supertonic 3 input contract coupled to visible text.",
        "properties": {
          "display_text": {
            "title": "Display Text",
            "type": "string"
          },
          "spoken_text": {
            "title": "Spoken Text",
            "type": "string"
          }
        },
        "required": [
          "display_text",
          "spoken_text"
        ],
        "title": "SpeechTextResponse",
        "type": "object"
      },
      "StartConversationRequest": {
        "description": "How the tablet starts a session.",
        "properties": {
          "photo_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Id"
          },
          "source": {
            "$ref": "#/components/schemas/ConversationSource"
          }
        },
        "required": [
          "source"
        ],
        "title": "StartConversationRequest",
        "type": "object"
      },
      "StartConversationResponse": {
        "description": "Session context and the first safe question.",
        "properties": {
          "photo": {
            "$ref": "#/components/schemas/PhotoMemoryResponse"
          },
          "question": {
            "$ref": "#/components/schemas/SpeechTextResponse"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConversationStatus"
          }
        },
        "required": [
          "session_id",
          "status",
          "photo",
          "question"
        ],
        "title": "StartConversationResponse",
        "type": "object"
      },
      "TabletPairingRequest": {
        "description": "One-time tablet pairing credential.",
        "properties": {
          "pairing_code": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Pairing Code",
            "type": "string"
          }
        },
        "required": [
          "pairing_code"
        ],
        "title": "TabletPairingRequest",
        "type": "object"
      },
      "TabletStateResponse": {
        "description": "Everything needed to render the next tablet home state.",
        "properties": {
          "active_conversation_session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Conversation Session Id"
          },
          "active_routines": {
            "items": {
              "$ref": "#/components/schemas/RoutinePromptResponse"
            },
            "title": "Active Routines",
            "type": "array"
          },
          "conversation_suggestion": {
            "$ref": "#/components/schemas/ConversationSuggestionResponse"
          },
          "photos": {
            "items": {
              "$ref": "#/components/schemas/PhotoMemoryResponse"
            },
            "title": "Photos",
            "type": "array"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          }
        },
        "required": [
          "server_time",
          "active_routines",
          "conversation_suggestion",
          "photos",
          "active_conversation_session_id"
        ],
        "title": "TabletStateResponse",
        "type": "object"
      },
      "TurnMetricResponse": {
        "description": "Non-sensitive metrics produced from one audio turn.",
        "properties": {
          "chars_per_second": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chars Per Second"
          },
          "next_question": {
            "$ref": "#/components/schemas/SpeechTextResponse"
          },
          "no_response": {
            "title": "No Response",
            "type": "boolean"
          },
          "speech_detected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speech Detected"
          },
          "turn_duration_seconds": {
            "title": "Turn Duration Seconds",
            "type": "number"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          },
          "utterance_chars": {
            "title": "Utterance Chars",
            "type": "integer"
          }
        },
        "required": [
          "turn_id",
          "utterance_chars",
          "turn_duration_seconds",
          "chars_per_second",
          "no_response",
          "speech_detected",
          "next_question"
        ],
        "title": "TurnMetricResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "GuardianSession": {
        "in": "cookie",
        "name": "reminiscence_guardian_session",
        "type": "apiKey"
      },
      "TabletSession": {
        "in": "cookie",
        "name": "reminiscence_tablet_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Reminiscence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health/live": {
      "get": {
        "description": "Return without touching models, JSON, or background jobs.",
        "operationId": "get_liveness_api_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "description": "Check all local dependencies used to serve tablet traffic.",
        "operationId": "get_readiness_api_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Not ready"
          }
        },
        "summary": "Check appliance readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/anomaly/state": {
      "get": {
        "description": "Return the last evaluation without rerunning either model.",
        "operationId": "get_anomaly_state_api_v1_anomaly_state_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalStateResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "GuardianSession": []
          }
        ],
        "summary": "Get the latest personal state",
        "tags": [
          "anomaly"
        ]
      }
    },
    "/api/v1/auth/guardian/login": {
      "post": {
        "description": "Issue a guardian session cookie after plaintext JSON comparison.",
        "operationId": "guardian_login_api_v1_auth_guardian_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuardianLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Guardian Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/guardian/logout": {
      "post": {
        "description": "Revoke the guardian cookie hash and expire the browser cookie.",
        "operationId": "guardian_logout_api_v1_auth_guardian_logout_post",
        "responses": {
          "204": {
