# 이 파일을 .env로 복사해서 값을 채우세요. .env는 커밋되지 않습니다.
# 실제 키를 이 예제 파일에 넣지 마세요.

# 필수
OPENAI_API_KEY=sk-...

# OpenAI 직결이 아니라 호환 프록시·게이트웨이를 쓸 때만 지정
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# 선택 (기본값으로 두어도 동작합니다)
# DIALOGUE_MODEL=gpt-4o-mini
# DIALOGUE_TEMPERATURE=0.7
# DIALOGUE_MAX_TOKENS=300
# DIALOGUE_HISTORY_TURNS=8
# DIALOGUE_TIMEOUT_SECONDS=15
# DIALOGUE_MAX_RETRIES=1
# DIALOGUE_CORS_ORIGINS=http://localhost:5173
