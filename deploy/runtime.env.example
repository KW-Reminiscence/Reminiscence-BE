ETRI_API_KEY=replace-with-issued-key
ETRI_ASR_URL=http://epretx.etri.re.kr:8000/api/WiseASR_Recognition
ETRI_MIN_INTERVAL_SECONDS=1.5
ETRI_MAX_RETRIES=2
ETRI_RETRY_BACKOFF_SECONDS=1.0
ETRI_CONNECT_TIMEOUT_SECONDS=10
ETRI_READ_TIMEOUT_SECONDS=30
REMINISCENCE_TIMEZONE=Asia/Seoul
REMINISCENCE_ROUTINE_TICK_SECONDS=5
REMINISCENCE_EVALUATION_SECONDS=60
REMINISCENCE_ANOMALY_CONFIRMATION_COUNT=3
# Vercel example: https://your-tablet.vercel.app
# Local file example: null
REMINISCENCE_CORS_ORIGINS=
SUPERTONIC_AUTO_DOWNLOAD=false
SUPERTONIC_VOICE=F1
SUPERTONIC_LANGUAGE=ko
SUPERTONIC_TOTAL_STEPS=8
SUPERTONIC_SPEED=0.9
SUPERTONIC_MAX_TEXT_CHARS=500
SUPERTONIC_INTRA_OP_THREADS=4
SUPERTONIC_INTER_OP_THREADS=1
